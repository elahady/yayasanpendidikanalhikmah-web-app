# Koneksi ke MySQL (reuse container shared-mysql di VPS — buat database baru khusus
# project ini, misal `tpq_alhikmah`, jangan pakai database app lain).
DATABASE_URL="mysql://user:password@localhost:3306/tpq_alhikmah"

# NextAuth
# Generate dengan: npx auth secret
AUTH_SECRET="ganti-dengan-secret-acak"

# Dipakai sekali oleh prisma/seed.ts untuk membuat akun TU pertama.
TU_USERNAME="tu"
TU_PASSWORD="ganti-dengan-password-kuat"
