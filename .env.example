# Koneksi ke MySQL (reuse container shared-mysql di VPS — buat database baru khusus
# project ini, misal `tpq_alhikmah`, jangan pakai database app lain).
DATABASE_URL="mysql://user:password@localhost:3306/tpq_alhikmah"

# NextAuth (web admin) + penandatangan JWT REST API v1 (/api/v1/auth/login)
# Generate dengan: npx auth secret
AUTH_SECRET="ganti-dengan-secret-acak"

# Dipakai prisma/seed.ts (npx tsx prisma/seed.ts). Seed idempoten: dijalankan ulang
# akan menyetel ulang password akun sesuai nilai di bawah. Isi salah satu atau keduanya.
# Akun ADMIN (akses penuh web /admin + API).
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ganti-dengan-password-kuat"
# Akun TU (hak sama dengan ADMIN saat ini). Kalau TU sudah ada dari migrasi,
# seed hanya menyetel ulang password-nya dan memastikan role TU.
TU_USERNAME="tu"
TU_PASSWORD="ganti-dengan-password-kuat"
